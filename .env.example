BETPAWA_URL=https://www.betpawa.ug/virtual-sports?virtualTab=results&leagueId=7794
LEAGUE_ID=7794
LEAGUE_NAME=English League
HEADLESS=true

# Leave these blank on Linux/Docker to use Playwright's bundled Chromium.
# For local Windows debugging you can set BROWSER_CHANNEL=chrome or CHROME_PATH.
BROWSER_CHANNEL=
CHROME_PATH=

MAX_SEASONS=10
SKIP_LATEST_SEASON=true
MATCHDAYS_PER_SEASON=34
ACTION_DELAY_MS=500
PAGE_READY_TIMEOUT_MS=30000

# PostgreSQL container settings. Change POSTGRES_PASSWORD in your real .env.
POSTGRES_DB=bp
POSTGRES_USER=bp_user
POSTGRES_PASSWORD=change_me

# Used when running the collector outside Docker.
# Docker Compose overrides DATABASE_URL so it points to the postgres service.
DATABASE_URL=postgresql://bp_user:change_me@localhost:5432/bp

# Main historical-results collector runs once per day at 1:00 PM Kampala time.
COLLECT_TIME=13:00
COLLECT_TIMEZONE=Africa/Kampala

# Retry after a failed scheduled collection.
COLLECT_RETRY_SECONDS=300

# Metabase browser port on the VPS.
METABASE_PORT=3000
