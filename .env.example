BETPAWA_URL=https://www.betpawa.ug/virtual-sports?virtualTab=results&leagueId=7794
LEAGUE_ID=7794
LEAGUE_NAME=English League
HEADLESS=true

# Leave these blank on Linux/Docker to use Playwright's bundled Chromium.
# For local Windows debugging you can set BROWSER_CHANNEL=chrome or CHROME_PATH.
BROWSER_CHANNEL=
CHROME_PATH=

MAX_SEASONS=10
SKIP_LATEST_SEASON=true
MATCHDAYS_PER_SEASON=34
ACTION_DELAY_MS=500
PAGE_READY_TIMEOUT_MS=30000

# PostgreSQL container settings. Change POSTGRES_PASSWORD in your real .env.
POSTGRES_DB=bp
POSTGRES_USER=bp_user
POSTGRES_PASSWORD=change_me

# Used when running the collector or notebook training outside Docker.
# Docker Compose overrides DATABASE_URL so it points to the postgres service.
DATABASE_URL=postgresql://bp_user:change_me@localhost:5432/bp

# Historical data source for notebooks/01_btts_model_training.ipynb:
# - csv: load local Match day results/match_results.csv
# - postgres: load match_results from PostgreSQL via DATABASE_URL
TRAINING_DATA_SOURCE=csv

# Main historical-results collector runs once per day at 1:00 PM Kampala time.
COLLECT_TIME=13:00
COLLECT_TIMEZONE=Africa/Kampala

# Retry after a failed scheduled collection.
COLLECT_RETRY_SECONDS=300

# Metabase browser port on the VPS.
METABASE_PORT=3000

# MLflow tracking UI/API port. Docker binds it to VPS localhost only.
# Access from your laptop through an SSH tunnel rather than opening this port publicly.
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=BTTS Prediction
MLFLOW_REGISTERED_MODEL_NAME=btts-predictor

# Automated VPS training writes candidate artifacts here. The Docker trainer
# overrides these paths with its internal /app paths.
TRAINING_ODDS_PATH=odds/final_odds/final_odds.csv
TRAINING_OUTPUT_DIR=training-output/latest-candidate
TRAINING_USE_DATABASE_LOCK=true
