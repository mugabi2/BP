BETPAWA_URL=https://www.betpawa.ug/virtual-sports?virtualTab=results&leagueId=7794
LEAGUE_ID=7794
LEAGUE_NAME=English League
HEADLESS=true
BROWSER_CHANNEL=chrome
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
MAX_SEASONS=10
SKIP_LATEST_SEASON=true
MATCHDAYS_PER_SEASON=34
ACTION_DELAY_MS=500
PAGE_READY_TIMEOUT_MS=30000

# MLflow tracking. On a laptop, point this to the local end of the SSH tunnel.
# Inside the VPS Docker network, use http://mlflow:5000.
MLFLOW_TRACKING_URI=http://127.0.0.1:5002
MLFLOW_EXPERIMENT_NAME=BTTS Prediction
MLFLOW_REGISTERED_MODEL_NAME=btts-predictor
